+++ b/dom/html/HTMLCanvasElement.h
@@ -351,6 +351,19 @@ class HTMLCanvasElement final : public nsGenericHTMLElement,
 
   bool IsOffscreen() const { return !!mOffscreenCanvas; }
   OffscreenCanvas* GetOffscreenCanvas() const { return mOffscreenCanvas; }
+  // M2.9 GfxXray: the main-thread display helper bridging a transferred
+  // (worker-owned) offscreen canvas — its buffer read is mutex-guarded
+  // and returns the current frame.
+  OffscreenCanvasDisplayHelper* GetOffscreenDisplay() const {
+    return mOffscreenDisplay;
+  }
+  // M2.9 GfxXray: native, JS-free drawing-buffer read covering every
+  // canvas flavor (2D, WebGL, worker-transferred offscreen).
+  UniquePtr<uint8_t[]> GetImageBufferPublic(
+      CanvasUtils::ImageExtraction aExtractionBehavior, int32_t* aOutFormat,
+      gfx::IntSize* aOutImageSize) {
+    return GetImageBuffer(aExtractionBehavior, aOutFormat, aOutImageSize);
+  }
   void FlushOffscreenCanvas();
 
   layers::ImageContainer* GetImageContainer() const { return mImageContainer; }
