--- a/dom/canvas/OffscreenCanvasDisplayHelper.h
+++ b/dom/canvas/OffscreenCanvasDisplayHelper.h
@@ -6,6 +6,7 @@
 #define MOZILLA_DOM_OFFSCREENCANVASDISPLAYHELPER_H_
 
 #include "GLContextTypes.h"
+#include "mozilla/dom/WorkerRef.h"
 #include "ImageContainer.h"
 #include "mozilla/Maybe.h"
 #include "mozilla/Mutex.h"
@@ -65,6 +66,21 @@ class OffscreenCanvasDisplayHelper final {
     return !!mWorkerRef;
   }
 
+  // M2.9 GfxXray: the owning worker (nullptr for main-thread canvases).
+  // The ThreadSafeWorkerRef keeps the worker alive while held.
+  dom::WorkerPrivate* GetWorkerPrivate() const {
+    MutexAutoLock lock(mMutex);
+    return mWorkerRef ? mWorkerRef->Private() : nullptr;
+  }
+
+
+  // M2.9 GfxXray: the canvas itself (only valid on the owning thread —
+  // the caller must already be there or dispatch through it).
+  already_AddRefed<OffscreenCanvas> GetCanvas() const {
+    MutexAutoLock lock(mMutex);
+    return do_AddRef(mOffscreenCanvas);
+  }
+
   void SetWriteOnly(nsIPrincipal* aExpandedReader = nullptr);
   bool CallerCanRead(nsIPrincipal& aPrincipal) const;
 
diff --git a/dom/html/HTMLCanvasElement.h b/dom/html/HTMLCanvasElement.h
