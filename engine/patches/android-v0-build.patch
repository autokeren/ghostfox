 # file, You can obtain one at http://mozilla.org/MPL/2.0/.
 
-DIRS += ["components", "screencast", "pipe"]
+DIRS += ["components", "pipe"]
+
+# The screencast service captures DESKTOP windows (DesktopCaptureImpl);
+# Android has none — skip it on the mobile build.
