diff --git a/build.gradle b/build.gradle
index 0b269cd4b3..67ea2aeb42 100644
--- a/build.gradle
+++ b/build.gradle
@@ -169,7 +169,11 @@ allprojects {
 // are the milestone.
 // This simply strips that off, leaving "61.0" in this example.
 def getAppVersionWithoutMilestone() {
-    return project.ext.mozconfig.substs.MOZ_APP_VERSION.replaceFirst(/[ab][0-9]/, "")
+    // Ghostfox: upstream Camoufox versions carry "-beta.N" suffixes which
+    // gradle's versionCode math cannot parse — strip them too.
+    return project.ext.mozconfig.substs.MOZ_APP_VERSION
+        .replaceFirst(/-beta\.[0-9]+/, "")
+        .replaceFirst(/[ab][0-9]/, "")
 }
 
 // This converts MOZ_APP_VERSION into an integer
