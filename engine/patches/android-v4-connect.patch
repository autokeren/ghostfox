diff --git a/mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/SettingsActivity.java b/mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/SettingsActivity.java
index ef994e25af..dc76a02599 100644
--- a/mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/SettingsActivity.java
+++ b/mobile/android/geckoview_example/src/main/java/org/mozilla/geckoview_example/SettingsActivity.java
@@ -51,6 +51,37 @@ public class SettingsActivity extends AppCompatActivity {
           edgeToEdge.setEnabled(false);
         }
       }
+
+      // Ghostfox Connect: dial OUT to the MCP gateway and bridge the
+      // pipe to the local juggler listener.
+      final Preference connect =
+          findPreference(getString(R.string.key_ghostfox_connect));
+      if (connect != null) {
+        connect.setOnPreferenceClickListener(
+            pref -> {
+              final String server =
+                  getPreferenceManager()
+                      .getSharedPreferences()
+                      .getString(getString(R.string.key_ghostfox_server), "");
+              final String token =
+                  getPreferenceManager()
+                      .getSharedPreferences()
+                      .getString(getString(R.string.key_ghostfox_token), "");
+              final Preference status =
+                  findPreference(getString(R.string.key_ghostfox_status));
+              GhostfoxConnect.connect(
+                  server,
+                  token,
+                  getContext(),
+                  msg -> {
+                    if (status != null) {
+                      getActivity()
+                          .runOnUiThread(() -> status.setSummary(msg));
+                    }
+                  });
+              return true;
+            });
+      }
     }
   }
 }
