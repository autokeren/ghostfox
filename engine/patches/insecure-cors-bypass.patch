 namespace {
+// Ghostfox E2E testing mode: skip CORS entirely (the Chrome
+// --disable-web-security equivalent). Local backends without
+// Access-Control-Allow-Origin headers (flutter web + localhost API)
+// become reachable. Gated by an env var — never on by default.
+bool GhostfoxInsecureCors() {
+  static bool v = []() {
+    const char* e = PR_GetEnv("GHOSTFOX_INSECURE_CORS");
+    return e && *e && strcmp(e, "0") != 0;
+  }();
+  return v;
+}
