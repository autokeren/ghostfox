+static bool ChromeCsiShim(JSContext* aCx, unsigned aArgc, JS::Value* aVp) {
+  JS::CallArgs args = JS::CallArgsFromVp(aArgc, aVp);
+  JS::RootedObject obj(aCx, JS_NewPlainObject(aCx));
+  args.rval().setObjectOrNull(obj);
+  return true;
