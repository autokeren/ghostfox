+
+void nsGlobalWindowInner::GetChrome(JSContext* aCx,
+                                    JS::MutableHandle<JS::Value> aRetval,
+                                    mozilla::ErrorResult& aError) {
+  JS::RootedObject chromeObj(aCx, JS_NewPlainObject(aCx));
+  if (!chromeObj) {
+    aError.Throw(NS_ERROR_OUT_OF_MEMORY);
+    return;
+  }
+  JS::RootedObject app(aCx, JS_NewPlainObject(aCx));
+  JS::RootedObject runtime(aCx, JS_NewPlainObject(aCx));
+  JS::RootedObject webstore(aCx, JS_NewPlainObject(aCx));
+  JS_DefineProperty(aCx, chromeObj, "app", app, JSPROP_ENUMERATE);
+  JS_DefineProperty(aCx, chromeObj, "runtime", runtime, JSPROP_ENUMERATE);
+  JS_DefineProperty(aCx, chromeObj, "webstore", webstore, JSPROP_ENUMERATE);
+  JS_DefineFunction(aCx, chromeObj, "csi", ChromeCsiShim, 0, 0);
+  JS_DefineFunction(aCx, chromeObj, "loadTimes", ChromeCsiShim, 0, 0);
+  aRetval.setObject(*chromeObj);
+}
