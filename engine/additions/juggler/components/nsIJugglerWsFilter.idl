#include "nsISupports.idl"

/**
 * Ghostfox WS blocking: per-serial frame filter. The content-side
 * WebSocketChannelChild (outgoing) and WebSocketImpl (incoming)
 * consult this singleton; the frame script sets the blocked set via
 * Page.setWebSocketBlocked.
 */
[scriptable, builtinclass, uuid(1f2b5c6d-3e4f-4a5b-8c9d-0a1b2c3d4e5f)]
interface nsIJugglerWsFilter : nsISupports
{
  void setBlocked(in unsigned long aSerial, in boolean aBlocked);
  boolean isBlocked(in unsigned long aSerial);
};
