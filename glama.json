{
  "name": "ghostfox",
  "displayName": "Ghostfox — The Agent Browser",
  "description": "Self-hosted stealth browser for AI agents. Own Firefox engine fork + Rust MCP runtime. Semantic vision (page_a11y), session awareness (login_state), evidence recording, Android personas, anti-detect at C++ level.",
  "version": "0.4.0",
  "author": {
    "name": "autokeren",
    "url": "https://github.com/autokeren"
  },
  "repository": "https://github.com/autokeren/ghostfox",
  "homepage": "https://autokeren.github.io/ghostfox/",
  "documentation": "https://autokeren.github.io/ghostfox/",
  "license": "SEE LICENSE FILE (dual: MPL-2.0 engine, MIT/Apache-2.0 runtime)",
  "keywords": [
    "browser",
    "stealth",
    "anti-detect",
    "ai-agents",
    "mcp",
    "rust",
    "firefox",
    "web-scraping",
    "fingerprint",
    "automation"
  ],
  "categories": [
    "Browser Automation",
    "Agent Orchestration",
    "Web Scraping"
  ],
  "platforms": [
    "linux",
    "darwin",
    "win32"
  ],
  "architectures": [
    "x64",
    "arm64"
  ],
  "mcp": {
    "type": "local",
    "command": "ghostfox",
    "args": ["mcp"],
    "env": {
      "GHOSTFOX_HOME": {
        "description": "Path to the unpacked Ghostfox engine directory",
        "required": true
      }
    }
  },
  "install": {
    "pip": "pip install ghostfox",
    "npm": "npm install ghostfox",
    "docker": "docker pull ghcr.io/autokeren/ghostfox"
  },
  "tools": [
    "session_create",
    "page_open",
    "page_a11y",
    "page_click_ref",
    "page_type_ref",
    "page_read_ref",
    "page_wait_for",
    "page_upload_file",
    "page_screenshot",
    "page_eval",
    "page_snapshot",
    "page_click",
    "page_type",
    "page_fill",
    "page_press",
    "page_dismiss_modal",
    "confirm_action",
    "identity_generate",
    "identity_audit",
    "session_evidence",
    "captcha_solve"
  ]
}
